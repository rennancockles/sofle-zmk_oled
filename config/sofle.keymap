#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define RAISE 1
#define DROP 2
#define ADJUST 3
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30   // default: 10
#define ZMK_MOUSE_SCRL_VAL 120

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <DROP RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        msc_scroll: msc_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "Mouse Scroll";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <120>;
        };

        msc_scroll_h: msc_scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            label = "Mouse Scroll H";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <120>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            label = "Default";

            bindings = <
&kp GRAVE     &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                               &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp MINUS
&kp TAB       &kp Q   &kp W      &kp E     &kp R     &kp T                                &kp Y      &kp U     &kp I      &kp O      &kp P     &kp BACKSPACE
&kp CAPSLOCK  &kp A   &kp S      &kp D     &kp F     &kp G                                &kp H      &kp J     &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT     &kp Z   &kp X      &kp C     &kp V     &kp B       &kp C_MUTE    &none      &kp N      &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                      &kp LCTRL  &kp LALT  &kp LGUI  &mo RAISE   &kp SPACE     &kp ENTER  &mo DROP   &kp RGUI  &kp RALT   &kp RCTRL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&msc_scroll>;
        };

        raise_layer {
            display-name = "raise";
            label = "Raise";

            bindings = <
&kp ESCAPE  &kp F1     &kp F2     &kp F3            &kp F4     &kp F5                     &trans                &trans                 &trans     &trans     &trans    &kp EQUAL
&trans      &kp F6     &kp F7     &kp F8            &kp F9     &kp F10                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS   &trans     &trans    &trans
&trans      &trans     &trans     &kp LA(LS(DOWN))  &trans     &trans                     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL  &trans     &trans    &kp PIPE
&trans      &kp LG(Z)  &kp LG(X)  &kp LG(C)         &kp LG(V)  &trans   &trans    &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMI   &kp COLON  &kp BSLH  &trans
                       &trans     &trans            &trans     &trans   &trans    &trans  &trans                &trans                 &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&msc_scroll>;
        };

        drop_layer {
            display-name = "drop";
            label = "Drop";

            bindings = <
&kp ESCAPE  &trans     &trans     &trans            &kp LG(LS(LC(NUMBER_4)))  &trans                    &trans     &trans        &trans            &trans         &trans  &kp LS(DELETE)
&trans      &trans     &trans     &trans            &trans                    &trans                    &kp PG_UP  &trans        &kp UP            &trans         &trans  &kp DELETE
&trans      &trans     &trans     &kp LS(LA(DOWN))  &trans                    &trans                    &kp PG_DN  &kp LEFT      &kp DOWN          &kp RIGHT      &trans  &trans
&trans      &kp LG(Z)  &kp LG(X)  &kp LG(C)         &kp LG(V)                 &trans  &trans    &trans  &trans     &kp LC(LEFT)  &kp LC(UP_ARROW)  &kp LC(RIGHT)  &trans  &trans
                       &trans     &trans            &trans                    &trans  &trans    &trans  &trans     &trans        &trans            &trans
            >;

            sensor-bindings = 
                <&msc_scroll>, 
                <&msc_scroll_h>;
        };

        adjust_layer {
            display-name = "adjust";
            label = "Adjust";

            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                           &trans  &none  &none  &none  &none  &none
&none       &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF                                        &none   &none  &none  &none  &none  &none
&none       &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR                                        &none   &none  &none  &none  &none  &none
&none       &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &ext_power EP_TOG  &none   &none  &none  &none  &none  &none
                             &none            &none            &none            &none            &none              &none              &none   &none  &none  &none
            >;

            sensor-bindings = 
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
